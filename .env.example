AI_PROVIDER=omnirouter
# Cấu hình an toàn cho NucBox G3 Plus 8 GB / Intel N150.
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_RENDERS=1
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_PUBLISHES=2

# PostgreSQL local qua Docker Compose. Đặt mật khẩu riêng trong .env.
POSTGRES_USER=video_studio
POSTGRES_PASSWORD=
POSTGRES_DB=video_studio
POSTGRES_PORT=5433
# Trong Docker, Compose tự đặt POSTGRES_HOST=postgres và POSTGRES_PORT=5432 cho app.
# Khi chạy Node trực tiếp, mặc định kết nối 127.0.0.1:5433.
# Tùy chọn: FLOW_DOWNLOAD_HOST_DIR=C:/Users/<user>/Downloads/flow-tryon
# Mặc định Compose theo dõi .downloads/flow-tryon trong dự án.
# Tùy chọn: DATABASE_URL=postgresql://... (nếu không dùng các biến POSTGRES_* ở trên)
OMNIROUTER_API_KEY=
OMNIROUTER_GEMINI_BASE_URL=http://host.docker.internal:20128/v1beta
OMNIROUTER_MODEL=antigravity/gemini-3.7-flash-tiered
OMNIROUTER_SEARCH_MODEL=antigravity/gemini-3.7-flash-tiered
OMNIROUTER_QUOTE_MODEL=antigravity/gemini-3.7-flash-tiered
# Đổi AI_PROVIDER=gemini để dùng các biến Google AI Studio bên dưới.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SEARCH_MODEL=gemini-3.8-flash
GEMINI_QUOTE_MODEL=gemini-3.1-flash-lite
PIXABAY_API_KEY=
# Pexels tạm dừng cấp key mới; chỉ điền nếu đã có key từ trước.
PEXELS_API_KEY=
COVERR_API_KEY=
# Khuyên dùng cho nút Đăng video: kết nối các tài khoản trong Zernio rồi điền API key sk_...
ZERNIO_API_KEY=
ZERNIO_YOUTUBE_API_KEY=
# Tùy chọn nếu API key truy cập nhiều hồ sơ Zernio mà không có hồ sơ mặc định.
ZERNIO_PROFILE_ID=
ZERNIO_YOUTUBE_PROFILE_ID=
# Chỉ dùng cho lệnh CLI npm run post hoặc khi không dùng Zernio.
# Đây phải là TikTok user OAuth access token, không phải Zernio API key.
TIKTOK_ACCESS_TOKEN=
# Facebook dùng Page Access Token có quyền pages_manage_posts (đăng vào Page, không phải profile cá nhân).
# Nếu Facebook chưa kết nối trong Zernio, biến này cho phép đăng trực tiếp qua Meta Graph API.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v26.0
# YouTube dùng OAuth scope youtube.upload. Có thể dùng access token ngắn hạn,
# hoặc bộ client ID / secret / refresh token để tự lấy access token mỗi lượt đăng.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Tùy chọn: đường dẫn Chrome cho trang Thử đồ Flow (mặc định là Chrome cài trong Program Files).
FLOW_CHROME_PATH=
